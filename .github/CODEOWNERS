Directory.Build.props                      @jeffreypalermo @cm-ai-ops-bot
Directory.Build.targets                    @jeffreypalermo @cm-ai-ops-bot
NuGet.Config                               @jeffreypalermo @cm-ai-ops-bot
nuget.config                               @jeffreypalermo @cm-ai-ops-bot
NuGet.config                               @jeffreypalermo @cm-ai-ops-bot
global.json                                @jeffreypalermo @cm-ai-ops-bot

