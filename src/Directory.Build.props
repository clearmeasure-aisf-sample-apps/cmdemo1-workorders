<Project>
  <!-- #1535: every build fails on warnings and on warning-severity style rules.
       AnalysisLevel is the SDK 10.0 analyzer set, not the floating "latest" alias.
       Debug still allows a short unused-symbol list so a local iteration can compile.
       Release (PrivateBuild and CI) does not. The build scripts also pass
       /p:TreatWarningsAsErrors=true so non-compiler MSBuild task warnings fail too. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>10.0</AnalysisLevel>
    <WarningsNotAsErrors Condition="'$(Configuration)' == 'Debug'">CS0168;CS0219;CS1998;IDE0051;IDE0052</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- Ratchet (#1535): these advisories already fire on restore. Suppressing them keeps
       TreatWarningsAsErrors from failing the build on today's set. A new advisory is not
       in this list, so restore fails until the package is upgraded or the list is reviewed.
       The list may only shrink. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2fmv-rv2c-59x7" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-7hqp-7c5m-4vq6" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-846f-f764-76mx" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-c399-9853-6jmj" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-g27p-qf6j-c96c" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-qhrr-8q5h-9q3h" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-qjpx-jqm5-h2c4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-r955-8q5j-3h83" />
  </ItemGroup>

  <!-- #1516: ClearMeasure.NpoAnalyzers runs in every src project as a build analyzer.
       ReferenceOutputAssembly is false so the DLL is not a runtime dependency.
       UnitTests is the exception: the fixture constructs the analyzers, so it also compiles against the assembly.
       #1517 can add its own ItemGroup beside this one. -->
  <PropertyGroup>
    <NpoAnalyzersProject>$(MSBuildThisFileDirectory)Analyzers\ClearMeasure.NpoAnalyzers\ClearMeasure.NpoAnalyzers.csproj</NpoAnalyzersProject>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'ClearMeasure.NpoAnalyzers' and '$(MSBuildProjectName)' != 'UnitTests'">
    <ProjectReference Include="$(NpoAnalyzersProject)" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" IsAspireProjectResource="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'UnitTests'">
    <ProjectReference Include="$(NpoAnalyzersProject)" OutputItemType="Analyzer" ReferenceOutputAssembly="true" PrivateAssets="all" IsAspireProjectResource="false" />
  </ItemGroup>
</Project>
