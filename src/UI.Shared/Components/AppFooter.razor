@namespace ClearMeasure.Bootcamp.UI.Shared.Components

<footer class="site-footer" data-testid="@nameof(MainLayout.Elements.CopyrightFooter)">
    <div class="site-footer-inner">
        <div class="footer-left">
            <span class="site-footer-line">
                © @CopyrightYear
                <a class="site-footer-link"
                   href="https://clearmeasure.com/"
                   target="_blank"
                   rel="noopener noreferrer">Clear Measure <span class="visually-hidden">(opens in a new tab)</span></a>
            </span>
            <span class="site-footer-note" data-testid="@nameof(MainLayout.Elements.FooterNote)">
                Facility requests are typically reviewed within one business day.
            </span>
        </div>
        <div class="footer-right">
            <span class="site-footer-note" data-testid="@nameof(MainLayout.Elements.SoftwareVersion)">
                @AppVersion
                @if (_deployment.ShortSha is { } shortSha)
                {
                    <span> · </span>
                    <a data-testid="@nameof(MainLayout.Elements.GitSha)"
                       href="https://github.com/clearmeasure-aisf-sample-apps/cmdemo1-workorders/commit/@_deployment.GitSha"
                       target="_blank"
                       rel="noopener noreferrer"><span class="visually-hidden">Commit </span>@shortSha<span class="visually-hidden"> (opens in a new tab)</span></a>
                }
                else
                {
                    <span> · </span>
                    <span data-testid="@nameof(MainLayout.Elements.GitSha)">unknown</span>
                }
                <span> · </span>
                <span data-testid="@nameof(MainLayout.Elements.EnvironmentName)">@_deployment.EnvironmentName</span>
            </span>
            <span class="site-footer-note">
                <span> · </span>
                <a data-testid="@nameof(MainLayout.Elements.BackToTop)"
                   href="#top"
                   aria-label="Back to top of page">Back to top</a>
            </span>
        </div>
    </div>
</footer>
