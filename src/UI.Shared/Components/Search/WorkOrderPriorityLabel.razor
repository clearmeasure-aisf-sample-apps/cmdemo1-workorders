@inherits ComponentBase

<span class="priority @Row.PriorityCssClass">
    <span class="priority-bars" aria-hidden="true"><i></i><i></i><i></i></span>
    @Row.WorkOrder.Priority
</span>
@if (ShowHighBadge && Row.WorkOrder.Priority == WorkOrderPriority.High)
{
    <span class="priority-badge priority-badge--high" data-testid="@($"PriorityBadge{Row.Number}")">High</span>
}

@code {

    [Parameter, EditorRequired] public WorkOrderSearchResultRow Row { get; set; } = null!;

    /// <summary>Shows a "High" badge on high-priority rows (the ShowPriorityBadges feature flag).</summary>
    [Parameter] public bool ShowHighBadge { get; set; }
}
