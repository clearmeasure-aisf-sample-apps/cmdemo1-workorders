@implements Palermo.BlazorMvc.IListener<WorkOrderChangedEvent>
@using ClearMeasure.Bootcamp.Core.Queries
@using ClearMeasure.Bootcamp.UI.Shared.Pages
@using Microsoft.Extensions.Logging
@inherits AppComponentBase
@using System.Globalization

<div class="sla-health-card @CardStateClass" data-testid="@Elements.SlaHealthCard">
    @if (_health == null)
    {
        <div class="sla-health-loading" role="status">Loading...</div>
    }
    else if (_health.CurrentMonthPercentage is null)
    {
        <div class="sla-health-no-data" role="status" data-testid="@Elements.SlaHealthNoData">No data</div>
    }
    else
    {
        <div class="sla-health-content">
            <div class="sla-health-header">
                <h3 class="sla-health-title">This Month</h3>
                @if (!string.IsNullOrEmpty(_trendText))
                {
                    <span class="sla-health-trend" title="@_trendText">@_trendText</span>
                }
            </div>
            <div class="sla-health-value">@_health.CurrentMonthPercentage?.ToString("F0", CultureInfo.CurrentCulture)%</div>
            <div class="sla-health-progress">
                <div class="sla-health-bar" role="progressbar"
                     aria-label="Work orders meeting SLA this month"
                     aria-valuenow="@((int?)_health.CurrentMonthPercentage)" aria-valuemin="0" aria-valuemax="100"
                     aria-valuetext="@($"{_health.CurrentMonthPercentage:F0}%")"
                     style="width: @($"{_health.CurrentMonthPercentage:F0}%")">
                </div>
            </div>
            <div class="sla-health-subtitle">@_health.CurrentMonthOrderCount work order@(_health.CurrentMonthOrderCount == 1 ? "" : "s")</div>
        </div>
    }
</div>

@code {
    private SlaHealth? _health;
    private string? _trendText;

    private string CardStateClass => _health switch
    {
        null => "sla-health-card--loading",
        { CurrentMonthPercentage: null } => "sla-health-card--empty",
        _ => "sla-health-card--loaded"
    };

    public enum Elements
    {
        SlaHealthCard,
        SlaHealthNoData
    }

    public void Handle(WorkOrderChangedEvent theEvent)
    {
        InvokeAsync(LoadHealthAsync);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadHealthAsync();
    }

    private async Task LoadHealthAsync()
    {
        try
        {
            _health = await Bus.Send(new SlaHealthQuery());
        }
        catch (Exception ex)
        {
            // Sidebar card is non-critical: never let a failed metrics query break the app shell.
            Logger.LogWarning(ex, "SLA health metrics could not be loaded; card shows empty state.");
            _health = new SlaHealth();
        }
        _trendText = SlaHealth.TrendText(_health?.CurrentMonthPercentage, _health?.LastMonthPercentage);
        await InvokeAsync(StateHasChanged);
    }
}
