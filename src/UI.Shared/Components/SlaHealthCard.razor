@implements Palermo.BlazorMvc.IListener<WorkOrderChangedEvent>
@using ClearMeasure.Bootcamp.Core.Queries
@using ClearMeasure.Bootcamp.UI.Shared.Pages
@inherits AppComponentBase

<div class="sla-health-card" data-testid="@Elements.SlaHealthCard">
    @if (Health == null)
    {
        <div class="sla-health-loading">Loading...</div>
    }
    else if (Health.CurrentMonthPercentage is null)
    {
        <div class="sla-health-no-data">No data</div>
    }
    else
    {
        <div class="sla-health-content">
            <div class="sla-health-header">
                <h3 class="sla-health-title">This Month</h3>
                @if (!string.IsNullOrEmpty(TrendText))
                {
                    <span class="sla-health-trend" title="@TrendText">@TrendText</span>
                }
            </div>
            <div class="sla-health-value">@Health.CurrentMonthPercentage?.ToString("F0")%</div>
            <div class="sla-health-progress">
                <div class="sla-health-bar" role="progressbar" aria-valuenow="@((int?)Health.CurrentMonthPercentage)" aria-valuemin="0" aria-valuemax="100"
                     style="width: @($"{Health.CurrentMonthPercentage:F0}%")">
                </div>
            </div>
            <div class="sla-health-subtitle">@Health.CurrentMonthOrderCount work order@(Health.CurrentMonthOrderCount == 1 ? "" : "s")</div>
        </div>
    }
</div>

@code {
    private SlaHealth? Health;
    private string? TrendText;

    public enum Elements
    {
        SlaHealthCard
    }

    public void Handle(WorkOrderChangedEvent theEvent)
    {
        InvokeAsync(LoadHealthAsync);
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadHealthAsync();
    }

    private async Task LoadHealthAsync()
    {
        Health = await Bus.Send(new SlaHealthQuery());
        TrendText = SlaHealth.TrendText(Health?.CurrentMonthPercentage, Health?.LastMonthPercentage);
        await InvokeAsync(StateHasChanged);
    }
}
