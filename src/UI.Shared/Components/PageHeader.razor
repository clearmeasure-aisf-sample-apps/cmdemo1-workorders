@inherits ComponentBase

<header class="page-header">
    <div class="page-heading">
        <h1 title="@TitleTooltip" data-testid="@TitleTestId">@Title@TitleAddon</h1>
        @if (Subtitle != null)
        {
            <p class="page-subtitle" data-testid="@SubtitleTestId">@Subtitle</p>
        }
    </div>
    <div class="page-actions">
        @Actions
    </div>
</header>

@code {
    /// <summary>The page title shown in the h1.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    /// <summary>Optional markup inside the title, after the title text. Omitted when null.</summary>
    [Parameter] public RenderFragment? TitleAddon { get; set; }

    /// <summary>Tooltip text on the title.</summary>
    [Parameter] public string? TitleTooltip { get; set; }

    /// <summary>Test id on the title.</summary>
    [Parameter] public string? TitleTestId { get; set; }

    /// <summary>Optional line under the title; omitted when null.</summary>
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>Test id on the subtitle.</summary>
    [Parameter] public string? SubtitleTestId { get; set; }

    /// <summary>Buttons and links shown on the right of the header.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }
}
