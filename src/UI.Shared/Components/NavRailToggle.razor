@namespace ClearMeasure.Bootcamp.UI.Shared.Components

<button type="button"
        class="nav-rail-toggle"
        data-testid="@nameof(MainLayout.Elements.NavRailToggle)"
        @ref="_buttonRef"
        @onclick="OnToggleAsync"
        aria-controls="app-navigation-rail"
        aria-expanded="@Rail.NavToggleAriaExpanded"
        title="@Rail.NavToggleTitle"
        aria-label="@Rail.NavToggleTitle">
    @if (Rail.IsNavVisible)
    {
        <i class="bi bi-chevron-double-left" aria-hidden="true"></i>
    }
    else
    {
        <i class="bi bi-list" aria-hidden="true"></i>
    }
</button>
