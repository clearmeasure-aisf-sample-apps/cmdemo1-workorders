@using ClearMeasure.Bootcamp.UI.Shared.Pages

@if (Changes.Length == 0)
{
    <div class="status-history-section token-card" data-testid="@WorkOrderManage.Elements.StatusHistory">
        <h2 class="card-title">Status Change History</h2>
        <p data-testid="@WorkOrderManage.Elements.StatusHistory">No status changes recorded.</p>
    </div>
}
else
{
    <div class="status-history-section token-card" data-testid="@WorkOrderManage.Elements.StatusHistory">
        <h2 id="status-history-title" class="card-title">Status Change History</h2>
        <table class="table table-sm" aria-labelledby="status-history-title">
            <thead>
                <tr>
                    <th scope="col">Date</th>
                    <th scope="col">From Status</th>
                    <th scope="col">To Status</th>
                    <th scope="col">Changed By</th>
                    <th scope="col">Reason</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var change in Changes)
                {
                    <tr data-testid="@WorkOrderManage.Elements.StatusHistoryRow">
                        <td data-testid="@WorkOrderManage.Elements.StatusHistoryDate"><time datetime="@ToUtcIso8601(change.ChangedDate)">@ClientDateFormatter.Format(TimeZoneInfo.ConvertTime(change.ChangedDate, ChurchTimeZone.Chicago))</time></td>
                        <td data-testid="@WorkOrderManage.Elements.StatusHistoryFromStatus">@change.FromStatus</td>
                        <td data-testid="@WorkOrderManage.Elements.StatusHistoryToStatus">@change.ToStatus</td>
                        <td data-testid="@WorkOrderManage.Elements.StatusHistoryChangedBy">@change.ChangedBy?.GetFullName()</td>
                        <td data-testid="@WorkOrderManage.Elements.StatusHistoryReason">@change.Reason</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    /// <summary>The work order's status changes, newest first.</summary>
    [Parameter, EditorRequired] public WorkOrderStatusChange[] Changes { get; set; } = [];

    /// <summary>
    /// Persisted change times are UTC instants stored as DATETIME2 and read back as
    /// <see cref="DateTimeKind.Unspecified"/>; label them Utc so ISO 8601 round-trip emits a Z offset.
    /// </summary>
    private static DateTime AsUtc(DateTime value) => DateTime.SpecifyKind(value, DateTimeKind.Utc);

    private static string ToUtcIso8601(DateTime value) => AsUtc(value).ToString("o");
}
