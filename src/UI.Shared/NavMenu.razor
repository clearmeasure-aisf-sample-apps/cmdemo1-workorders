
<div class="nav-scrollable">
    <h2 class="nav-section" id="nav-section-workspace">Workspace</h2>
    <ul class="nav-list" aria-labelledby="nav-section-workspace">
        <li class="nav-item">
            <NavLink data-testid="@Elements.Dashboard" class="nav-link" href="" Match="NavLinkMatch.All" title="Dashboard">
                <i class="bi bi-grid-1x2-fill nav-icon" aria-hidden="true"></i>
                <span class="nav-text">Dashboard</span>
            </NavLink>
        </li>
        @if (CurrentUser != null)
        {
            <li class="nav-item">
                <NavLink data-testid="@Elements.Search" class="nav-link" href="workorder/search" title="Work Orders">
                    <i class="bi bi-clipboard2-check-fill nav-icon" aria-hidden="true"></i>
                    <span class="nav-text">Work Orders</span>
                    @Badge(Summary?.OpenCount, "open")
                </NavLink>
            </li>
        }
        @if (CurrentUser != null && CurrentUser.CanCreateWorkOrder())
        {
            <li class="nav-item">
                <NavLink data-testid="@Elements.NewWorkOrder" class="nav-link" href="workorder/manage?mode=New" title="New Request">
                    <i class="bi bi-plus-square-fill nav-icon" aria-hidden="true"></i>
                    <span class="nav-text">New Request</span>
                </NavLink>
            </li>
        }
        @if (CurrentUser != null)
        {
            <li class="nav-item">
                <NavLink data-testid="@Elements.AiAgent" class="nav-link" href="ai-agent" title="AI Assistant">
                    <i class="bi bi-robot nav-icon" aria-hidden="true"></i>
                    <span class="nav-text">AI Assistant</span>
                    <span class="nav-tag">New</span>
                </NavLink>
            </li>
        }
    </ul>

    @if (CurrentUser != null)
    {
        <h2 class="nav-section" id="nav-section-queue">My Queue</h2>
        <ul class="nav-list" aria-labelledby="nav-section-queue">
            @QueueLink(Elements.WorkOrdersAssignedToMe, $"workorder/search?Assignee={Uri.EscapeDataString(CurrentUser.UserName)}",
                "bi-person-check-fill", "Assigned to Me", Summary?.AssignedToMeTotal, false)
            @{ var createdByMeHref = $"workorder/search?Creator={Uri.EscapeDataString(CurrentUser.UserName)}"; }
            <li class="nav-item">
                <a data-testid="@Elements.MyWorkOrders" href="@createdByMeHref" title="Created by Me"
                   class="@LinkClass(createdByMeHref, false)" aria-current="@AriaCurrent(createdByMeHref)">
                    <i class="bi bi-person-badge-fill nav-icon" aria-hidden="true"></i>
                    <MyWorkOrders/>
                </a>
            </li>
            @QueueLink(Elements.AllWorkOrdersInProgress, $"workorder/search?Status={WorkOrderStatus.InProgress.Key}",
                "bi-hourglass-split", "In Progress", Summary?.InProgressCount, false)
            @QueueLink(Elements.Overdue, "workorder/search?OverdueOnly=true",
                "bi-exclamation-octagon-fill", "Overdue", Summary?.OverdueCount, true)
            <li class="nav-item">
                <LastWorkOrder/>
            </li>
        </ul>

        <h2 class="nav-section" id="nav-section-admin">Administration</h2>
        <ul class="nav-list" aria-labelledby="nav-section-admin">
            <li class="nav-item">
                <NavLink data-testid="@Elements.BuildingsAndRooms" class="nav-link" href="admin/buildings" title="Buildings & Rooms">
                    <i class="bi bi-building nav-icon" aria-hidden="true"></i>
                    <span class="nav-text">Buildings & Rooms</span>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink data-testid="@Elements.TeamsAndVendors" class="nav-link" href="admin/teams" title="Teams & Vendors">
                    <i class="bi bi-people-fill nav-icon" aria-hidden="true"></i>
                    <span class="nav-text">Teams & Vendors</span>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink data-testid="@Elements.Reports" class="nav-link" href="reports" title="Reports">
                    <i class="bi bi-bar-chart-fill nav-icon" aria-hidden="true"></i>
                    <span class="nav-text">Reports</span>
                </NavLink>
            </li>
            <li class="nav-item">
                <NavLink data-testid="@Elements.Settings" class="nav-link" href="settings" title="Settings">
                    <i class="bi bi-gear-fill nav-icon" aria-hidden="true"></i>
                    <span class="nav-text">Settings</span>
                </NavLink>
            </li>
        </ul>
    }

    @if (CurrentUser != null)
    {
        <SlaHealthCard/>
    }
</div>
@code
{
    public enum Elements
    {
        AiAgent,
        MyWorkOrders,
        WorkOrdersAssignedToMe,
        AllWorkOrdersInProgress,
        Search,
        Settings,
        NewWorkOrder,
        Dashboard,
        Overdue,
        NavBadge,
        Reports,
        TeamsAndVendors,
        BuildingsAndRooms
    }

    private RenderFragment QueueLink(Elements testId, string href, string icon, string label, int? count, bool danger) =>
        @<li class="nav-item">
            <a data-testid="@testId" href="@href" title="@label"
               class="@LinkClass(href, danger)" aria-current="@AriaCurrent(href)">
                <i class="bi @icon nav-icon" aria-hidden="true"></i>
                <span class="nav-text">@label</span>
                @Badge(count, danger ? "overdue" : "work orders")
            </a>
        </li>;

    private RenderFragment? Badge(int? count, string noun) => count.HasValue
        ? @<span class="nav-badge" data-testid="@(Elements.NavBadge)">@count<span class="visually-hidden"> @noun</span></span>
        : null;
}
