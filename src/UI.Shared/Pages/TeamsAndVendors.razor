@using ClearMeasure.Bootcamp.Core.FeatureFlags
@using ClearMeasure.Bootcamp.Core.Queries
@using ClearMeasure.Bootcamp.UI.Shared.Components.Teams

<PageTitle>Teams & Vendors - .NET Conf Work Orders</PageTitle>

<div class="teams-page">
    <div class="teams-container">
        <header class="teams-header">
            <h1>Teams & Vendors</h1>
            <p class="teams-subtitle">Everyone who works on work orders, with their load.</p>
        </header>

        @if (_tableData == null || _teamsData == null || _vendorsData == null)
        {
            <div class="teams-loading" role="status">
                <p>Loading...</p>
            </div>
        }
        else
        {
            <TeamWorkLoadTable Summaries="_tableData"/>
            <TeamCards Teams="_teamsData"/>
            @if (_vendorManagementEnabled)
            {
                <VendorCards Vendors="_vendorsData"/>
            }
        }
    </div>
</div>

@code {
    public enum Elements
    {
        TableRowName,
        TableRowRole,
        TableRowAssignedOpen,
        TableRowInProgress,
        TableRowOverdue,
        TableRowCompleted,
        TeamCard,
        TeamName,
        TeamDescription,
        TeamInfo,
        TeamMemberCount,
        TeamMembers,
        TeamMemberLink,
        TeamsEmptyState,
        VendorCard,
        VendorHeader,
        VendorName,
        VendorStatus,
        VendorTrade,
        VendorContactName,
        VendorEmail,
        VendorPhone,
        VendorsEmptyState
    }

    private List<EmployeeWorkLoadSummary>? _tableData;
    private List<Team>? _teamsData;
    private List<Vendor>? _vendorsData;

    protected override async Task OnInitializedAsync()
    {
        var summaries = await Bus.Send(new EmployeeWorkLoadSummaryQuery());
        _tableData = summaries.Where(summary => summary.Employee.CanFulfillWorkOrder()).ToList();

        var teams = await Bus.Send(new TeamsQuery());
        _teamsData = teams.ToList();

        _vendorManagementEnabled = await FeatureFlags.IsEnabledAsync(FeatureFlagNames.VendorManagement);
        if (_vendorManagementEnabled)
        {
            var vendors = await Bus.Send(new VendorsQuery());
            _vendorsData = vendors.ToList();
        }
        else
        {
            _vendorsData = [];
        }
    }
}
