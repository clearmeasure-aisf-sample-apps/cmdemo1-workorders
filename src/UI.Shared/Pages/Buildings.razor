@page "/admin/buildings"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization

<PageTitle>Buildings & Rooms - Kalahari Church Work Order System</PageTitle>

<div class="buildings-page">
    <div class="buildings-container">
        <header class="buildings-header">
            <h1>Buildings & Rooms</h1>
            <p class="buildings-subtitle">Work orders by facility and location.</p>
        </header>

        @if (_data == null)
        {
            <div class="buildings-loading">
                <p>Loading...</p>
            </div>
        }
        else if (_data.Length == 0)
        {
            <div class="buildings-empty-state">
                <p>No work orders found.</p>
            </div>
        }
        else
        {
            <section class="buildings-cards" aria-label="Buildings and rooms">
                @foreach (var building in _data)
                {
                    <article class="building-card" data-testid="@($"building-card-{building.BuildingName}")">
                        <div class="building-card-header">
                            <h2 class="building-card-title">@building.BuildingName</h2>
                        </div>
                        <div class="rooms-list">
                            @foreach (var room in building.Rooms)
                            {
                                <div class="room-item" data-testid="@($"room-item-{building.BuildingName}-{room.RoomName}")">
                                    <div class="room-name">@room.RoomName</div>
                                    <div class="room-counts">
                                        @{
                                            var buildingParam = building.BuildingName == "No building" ? null : Uri.EscapeDataString(building.BuildingName);
                                            var roomParam = room.RoomName == "No room" ? null : Uri.EscapeDataString(room.RoomName);
                                            var buildingQuery = building.BuildingName == "No building" ? "NoBuilding=true" : $"Building={buildingParam}";
                                            var roomQuery = room.RoomName == "No room" ? "NoRoom=true" : $"Room={roomParam}";
                                        }
                                        <a href="@($"workorder/search?{buildingQuery}&{roomQuery}&OpenOnly=true")"
                                           class="count-link"
                                           data-testid="@($"room-open-link-{building.BuildingName}-{room.RoomName}")">
                                            <span class="count-value">@room.OpenCount</span>
                                            <span class="count-label">Open</span>
                                        </a>
                                        <a href="@($"workorder/search?{buildingQuery}&{roomQuery}&OverdueOnly=true")"
                                           class="count-link"
                                           data-testid="@($"room-overdue-link-{building.BuildingName}-{room.RoomName}")">
                                            <span class="count-value">@room.OverdueCount</span>
                                            <span class="count-label">Overdue</span>
                                        </a>
                                        <a href="@($"workorder/search?{buildingQuery}&{roomQuery}&Status=Complete&CompletedWithinDays=30")"
                                           class="count-link"
                                           data-testid="@($"room-completed-link-{building.BuildingName}-{room.RoomName}")">
                                            <span class="count-value">@room.CompletedLast30DaysCount</span>
                                            <span class="count-label">Completed 30d</span>
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>
                    </article>
                }
            </section>
        }
    </div>
</div>
