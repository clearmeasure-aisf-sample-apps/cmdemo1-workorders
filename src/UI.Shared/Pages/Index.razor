@page "/"

<PageTitle>TechWeek Work Orders</PageTitle>

<div class="dashboard-page">
    <div class="dashboard-container">
        <PageHeader Title="TechWeek Work Orders" TitleTooltip="Work order home" TitleTestId="@nameof(Elements.HomeHeadingTooltip)"
                    Subtitle="Track and manage work orders in one place." SubtitleTestId="@nameof(Elements.HomeTagline)">
            <Actions>
                <AuthorizeView>
                    <Authorized>
                        @if (_canCreate)
                        {
                            <a class="btn-app btn-app--primary" data-testid="@nameof(Elements.QuickLinkNewRequest)" href="workorder/manage?mode=New">
                                <i class="bi bi-plus-lg" aria-hidden="true"></i> New Request
                            </a>
                        }
                        <a class="btn-app btn-app--secondary" data-testid="@nameof(Elements.QuickLinkWorkOrders)" href="workorder/search"
                           aria-label="All Work Orders">
                            <i class="bi bi-list-ul" aria-hidden="true"></i> Work Orders
                        </a>
                        <a class="btn-app btn-app--secondary" data-testid="@nameof(Elements.QuickLinkMyQueue)" href="@MyQueueHref">
                            <i class="bi bi-person-check" aria-hidden="true"></i> My queue
                        </a>
                    </Authorized>
                </AuthorizeView>
            </Actions>
        </PageHeader>

        <AuthorizeView>
            <Authorized>
                <WorkOrderSummaryCards Summary="_summary" LinkToSearch="true"/>

                @if (_statusCounts != null)
                {
                    <section class="status-cards" data-testid="@nameof(Elements.StatusDashboard)" aria-label="Work orders by status">
                        @foreach (var card in DashboardStatusCards.Build(_statusCounts))
                        {
                            <KpiCard TestId="@(nameof(Elements.StatusCard) + card.Status.Key)"
                                     ValueTestId="@(nameof(Elements.StatusCardCount) + card.Status.Key)"
                                     Label="@card.Status.FriendlyName" Count="card.Count" Tone="@card.Tone" Icon="@card.Icon"
                                     Href="@StatusHref(card.Status)"/>
                        }
                    </section>
                }

                <section class="recent-activity" data-testid="@nameof(Elements.RecentActivity)" aria-labelledby="recent-activity-heading">
                    <h2 id="recent-activity-heading" class="recent-activity-title">Recent activity</h2>
                    @if (_recent.Length == 0)
                    {
                        <p class="recent-activity-empty" data-testid="@nameof(Elements.RecentActivityEmpty)">No work order activity yet.</p>
                    }
                    else
                    {
                        <ol class="activity-list">
                            @foreach (var order in _recent)
                            {
                                <li class="activity-item" data-testid="@(nameof(Elements.RecentActivityItem) + order.Number)">
                                    <a class="activity-number" data-testid="@(nameof(Elements.RecentActivityLink) + order.Number)"
                                       href="/workorder/manage/@order.Number?mode=Edit">WO-@order.Number</a>
                                    <span class="activity-title">@order.Title</span>
                                    <span class="activity-meta">@ActivityText(order)</span>
                                </li>
                            }
                        </ol>
                    }
                </section>
            </Authorized>
            <NotAuthorized>
                <p class="sign-in-prompt" data-testid="@nameof(Elements.SignInPrompt)">Sign in to see your work orders.</p>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    public enum Elements
    {
        HomeTagline,
        HomeHeadingTooltip,
        StatusDashboard,
        StatusCard,
        StatusCardCount,
        QuickLinkNewRequest,
        QuickLinkWorkOrders,
        QuickLinkMyQueue,
        RecentActivity,
        RecentActivityItem,
        RecentActivityLink,
        RecentActivityEmpty,
        SignInPrompt
    }
}
