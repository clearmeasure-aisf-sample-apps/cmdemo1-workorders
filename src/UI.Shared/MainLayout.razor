@inherits Palermo.BlazorMvc.MvcLayoutComponentBase

<NavRail>
    <NotificationsBell>
        <div class="main-container" id="top">
            <header class="modern-header">
                <div class="header-content">
                    <div class="header-leading">
                        <NavRailToggle/>
                        <div class="header-title">
                            <Breadcrumbs/>
                        </div>
                    </div>
                    <AuthorizeView>
                        <Authorized>
                            <div class="header-search">
                                <GlobalSearchBox/>
                            </div>
                        </Authorized>
                    </AuthorizeView>
                    <div class="header-actions">
                        <a href="ai-agent"
                           class="icon-button"
                           data-testid="@nameof(Elements.HelpLink)"
                           title="Help"
                           aria-label="Help">
                            <i class="bi bi-question-lg" aria-hidden="true"></i>
                        </a>
                        <button type="button"
                                class="dark-mode-toggle icon-button"
                                data-testid="@nameof(Elements.DarkModeToggle)"
                                @onclick="ToggleDarkModeAsync"
                                title="@DarkModeToggleTitle"
                                aria-label="@DarkModeToggleTitle">
                            @if (Theme.IsDarkMode)
                            {
                                <i class="bi bi-moon" aria-hidden="true"></i>
                            }
                            else
                            {
                                <i class="bi bi-sun" aria-hidden="true"></i>
                            }
                        </button>
                        <NotificationsBellToggle/>
                        <AuthorizeView>
                            <Authorized>
                                <div class="user-section">
                                    <Logout/>
                                </div>
                            </Authorized>
                            <NotAuthorized>
                                <div class="auth-section">
                                    <LoginLink/>
                                </div>
                            </NotAuthorized>
                        </AuthorizeView>
                    </div>
                </div>
            </header>

            <NotificationsBellPanel/>

            <main class="modern-main" id="main-content" tabindex="-1">
                <div class="content-wrapper">
                    @Body
                </div>
            </main>

            <AppFooter/>
        </div>
    </NotificationsBell>
</NavRail>
