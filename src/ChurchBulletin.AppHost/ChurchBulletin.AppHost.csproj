<Project Sdk="Aspire.AppHost.Sdk/13.6.5">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>dotnet-Worker-b9b5c0f8-4249-469b-8bfb-c4cc9398b886</UserSecretsId>
    <!-- Aspire 13.6.5 warns ASPIRE010 when AspireUseCliBundle is false (the default). Keep the
         NuGet dashboard/DCP path so CI can build without installing the Aspire CLI; enabling
         AspireUseCliBundle=true fails CI with ASPIRE009 when the CLI bundle is missing. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\UI\Server\UI.Server.csproj" />
    <ProjectReference Include="..\Worker\Worker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Aspire.Hosting" />
  </ItemGroup>
</Project>
