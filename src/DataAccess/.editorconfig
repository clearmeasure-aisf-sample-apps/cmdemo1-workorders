# Severities for the DataAccess-only packages NPlusOne.Analyzers and LinqContraband.
# NP0001 and LC007 are errors: a query once per element. Every other diagnostic
# those packages add stays a suggestion so warnings-as-errors does not fail the build.
root = false

[*.cs]
dotnet_diagnostic.NP0001.severity = error
dotnet_diagnostic.NP0002.severity = suggestion
dotnet_diagnostic.NP0003.severity = suggestion
dotnet_diagnostic.NP0004.severity = suggestion
dotnet_diagnostic.NP0005.severity = suggestion
dotnet_diagnostic.NP0006.severity = suggestion
dotnet_diagnostic.NP0007.severity = suggestion
