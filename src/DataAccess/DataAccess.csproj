<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>ClearMeasure.Bootcamp.$(MSBuildProjectName)</AssemblyName>
		<RootNamespace>ClearMeasure.Bootcamp.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
		<Configurations>Debug;Release;exclude-maui.slnf</Configurations>
	</PropertyGroup>

	<ItemGroup>
    <PackageReference Include="Mediator.Abstractions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" />
    <PackageReference Include="Octopus.OpenFeature" />
    <PackageReference Include="OpenFeature" />
    <!-- Pin transitive SQLitePCLRaw above 2.1.11 to resolve NU1903 (GHSA-2m69-gcr7-jv3q). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <PackageReference Include="LinqContraband">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NPlusOne.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Core\Core.csproj" />
	</ItemGroup>

  <!-- RS0030: DataAccess reads the clock through TimeProvider, never the system clock. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>


  <!-- Native AOT (Exp 2): when McpServer is published with -p:McpServerAot=true (PublishAot), EF generates the compiled
       model and precompiled queries for DataContext during that publish (DesignTimeDataContextFactory picks SQL Server).
       Normal builds do not reference the tasks, so the JIT apps keep the runtime-built model and both providers. -->
  <ItemGroup Condition="'$(McpServerAot)' == 'true'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <!-- EF 11's generator can emit a file whose unsafe accessors name model types without a using for them (seen on
         WorkOrderBuildingsQueryHandler, a string-only projection); a global using covers every generated file. -->
    <Using Include="ClearMeasure.Bootcamp.Core.Model" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tasks" PrivateAssets="all" />
  </ItemGroup>
  <!-- UI-only read models whose queries are composed at run time (shared specifications, reused IQueryable bases,
       raw SQL), which EF cannot precompile. McpServer sends none of these requests, so its AOT build leaves them out;
       UI.Server (JIT) keeps them. Making them precompile means inlining every specification at each call site. -->
  <ItemGroup Condition="'$(McpServerAot)' == 'true'">
    <Compile Remove="Handlers\BuildingRoomSummaryQueryHandler.cs" />
    <Compile Remove="Handlers\EmployeeWorkLoadQueryHandler.cs" />
    <Compile Remove="Handlers\EmployeeWorkLoadSummaryQueryHandler.cs" />
    <Compile Remove="Handlers\NotificationsPanelQueryHandler.cs" />
    <Compile Remove="Handlers\RecentWorkOrdersQueryHandler.cs" />
    <Compile Remove="Handlers\UserWorkOrders.cs" />
    <Compile Remove="Handlers\WorkOrderReportsQueryHandler.cs" />
    <Compile Remove="Handlers\WorkOrderSearchSummaryQueryHandler.cs" />
    <Compile Remove="Handlers\WorkOrderSearchHandler.cs" />
    <Compile Remove="DatabaseMigrationVersionReader.cs" />
    <Compile Remove="TestSupport\**" />
  </ItemGroup>
  <ItemGroup Condition="'$(McpServerAot)' != 'true'">
    <Compile Remove="Handlers\AotWorkOrderSearchHandler.cs" />
  </ItemGroup>
  <PropertyGroup Condition="'$(McpServerAot)' == 'true'">
    <!-- The EF tool runs this class library with dotnet exec, which needs a runtimeconfig.json. -->
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <!-- The precompiled queries are C# interceptors generated into this namespace. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.EntityFrameworkCore.GeneratedInterceptors</InterceptorsNamespaces>
  </PropertyGroup>
</Project>