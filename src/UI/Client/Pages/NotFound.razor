@page "/not-found"
@layout MainLayout
@using ClearMeasure.Bootcamp.UI.Shared.Components

<PageTitle>Not Found - .NET Conf Work Orders</PageTitle>
<div class="not-found-page">
    <PageHeader Title="Not found" TitleTooltip="This address has no page" />
    <section class="not-found-card">
        <p role="alert"><i class="bi bi-exclamation-triangle" aria-hidden="true" data-testid="@Elements.NotFoundIcon"></i> Sorry, there's nothing at this address.</p>
        <nav class="not-found-links" aria-label="Suggested pages">
            <ul>
                <li><a href="/" data-testid="@Elements.NotFoundDashboardLink">Dashboard</a></li>
                <li><a href="/workorder/search" data-testid="@Elements.NotFoundWorkOrdersLink">Work Orders</a></li>
                <li><a href="/" data-testid="@Elements.NotFoundHomeLink">Return to the home page</a></li>
            </ul>
        </nav>
    </section>
</div>

@code {
    public enum Elements
    {
        NotFoundHomeLink,
        NotFoundIcon,
        NotFoundDashboardLink,
        NotFoundWorkOrdersLink
    }
}
