<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	  <AssemblyName>ClearMeasure.Bootcamp.$(MSBuildProjectName)</AssemblyName>
	  <RootNamespace>ClearMeasure.Bootcamp.$(MSBuildProjectName.Replace(" ", "_"))</RootNamespace>
    <Configurations>Debug;Release;exclude-maui.slnf</Configurations>
    <NoWarn>$(NoWarn);IL2037</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BlazorMvc" />
    <PackageReference Include="MediatR" />
    <PackageReference Include="Lamar.Microsoft.DependencyInjection" />
	  <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Toolbelt.Blazor.SpeechRecognition" />
    <PackageReference Include="Toolbelt.Blazor.SpeechSynthesis" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Core.csproj" />
    <ProjectReference Include="..\..\UI.Shared\UI.Shared.csproj" />
  </ItemGroup>

</Project>
